---
import Avatar from "../Avatar/Avatar.astro";
import styles from "./Header.module.css";

const session = Astro.locals.session;
const locale = Astro.currentLocale;
---

<header class={styles.header}>
  {session && <button id="logout">Logout</button>}
  <Avatar />
</header>

<script define:vars={{ locale }}>
  window.__locale = locale;
</script>

<script>
  import { DEFAULT_LOCALE } from "../../i18n/utils";

  const { signOut } = await import("../../lib/auth/authClient.ts");
  const logoutButton = document.querySelector("#logout");

  logoutButton?.addEventListener("click", () =>
    signOut({
      fetchOptions: {
        onSuccess: () => {
          window.location.href = `/${window.__locale ?? DEFAULT_LOCALE}/login`;
        },
      },
    }),
  );
</script>
