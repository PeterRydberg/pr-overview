---
import Avatar from "../components/Avatar/Avatar.astro";
import { Header } from "../components/Header/Header";
import { PullRequestList } from "../components/PullRequestList/PullRequestList";
import Layout from "../layouts/Layout.astro";

export const prerender = false;
---

<Layout>
  <Header slot="header">
    <div slot="loginLogoutButton">
      {
        Astro.locals.session ? (
          <button id="logout">Logout</button>
        ) : (
          <button id="login">Login</button>
        )
      }
    </div>
    <Avatar slot="avatar" client:load user={Astro.locals.user} />
  </Header>

  <p>{Astro.locals.user?.name}</p>

  {
    Astro.locals.accessToken?.accessToken && (
      <PullRequestList
        client:load
        accessToken={Astro.locals.accessToken.accessToken}
        user={Astro.locals.user}
      />
    )
  }

  <script>
    const { signOut } = await import("../lib/auth/authClient.ts");
    const logoutButton = document.querySelector("#logout");

    logoutButton?.addEventListener("click", () =>
      signOut({
        fetchOptions: {
          onSuccess: () => {
            window.location.href = "/login";
          },
        },
      }),
    );
  </script>
</Layout>
